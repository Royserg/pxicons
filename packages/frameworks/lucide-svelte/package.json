{
  "name": "@pxicons/lucide-svelte",
  "version": "0.0.0",
  "description": "Lucide pixel-art icon components for Svelte.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/lucide/index.d.ts",
      "svelte": "./dist/lucide/index.js",
      "default": "./dist/lucide/index.js"
    },
    "./icons": {
      "types": "./dist/lucide/icons/index.d.ts",
      "svelte": "./dist/lucide/icons/index.js",
      "default": "./dist/lucide/icons/index.js"
    },
    "./icons/*": {
      "types": "./dist/lucide/icons/*.svelte.d.ts",
      "svelte": "./dist/lucide/icons/*.js",
      "default": "./dist/lucide/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node ./scripts/generate-lucide.mjs",
    "build": "vp run generate && svelte-package --input ./src --output ./dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vp test",
    "prepublishOnly": "vp run build"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24",
    "svelte": "^5.51.0",
    "svelte-check": "^4.4.2",
    "typescript": "^5",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
