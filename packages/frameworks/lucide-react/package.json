{
  "name": "@pxicons/lucide-react",
  "version": "0.1.0",
  "description": "Lucide pixel-art icon components for React.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/lucide/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Royserg/pxicons.git",
    "directory": "packages/frameworks/lucide-react"
  },
  "homepage": "https://github.com/Royserg/pxicons/tree/dev/packages/frameworks/lucide-react#readme",
  "bugs": {
    "url": "https://github.com/Royserg/pxicons/issues"
  },
  "keywords": [
    "icons",
    "lucide",
    "pixel-art",
    "react",
    "react-icons"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/lucide/index.d.ts",
      "default": "./dist/lucide/index.js"
    },
    "./icons": {
      "types": "./dist/lucide/icons/index.d.ts",
      "default": "./dist/lucide/icons/index.js"
    },
    "./icons/*": {
      "types": "./dist/lucide/icons/*.d.ts",
      "default": "./dist/lucide/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node ./scripts/generate-lucide-react.mjs",
    "build": "vp run generate && rm -rf ./dist && vp exec tsc --project ./tsconfig.build.json",
    "test:consistency": "vp test -- --run tests/lucide-react-consistency.test.ts",
    "test": "vp test",
    "release:verify": "vp run generate && vp run test:consistency && vp run test && vp run build",
    "release:npm:dry-run": "vp exec pnpm publish --dry-run --no-git-checks",
    "release:check": "vp run release:verify && vp run release:npm:dry-run",
    "release:npm": "vp run release:check && vp exec pnpm publish --no-git-checks",
    "prepublishOnly": "vp run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@pxicons/lucide": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
