{
  "name": "@pxicons/lucide-react",
  "version": "0.1.0",
  "description": "Lucide pixel-art icon components for React.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/lucide/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/lucide/index.d.ts",
      "default": "./dist/lucide/index.js"
    },
    "./icons": {
      "types": "./dist/lucide/icons/index.d.ts",
      "default": "./dist/lucide/icons/index.js"
    },
    "./icons/*": {
      "types": "./dist/lucide/icons/*.d.ts",
      "default": "./dist/lucide/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node ./scripts/generate-lucide-react.mjs",
    "build": "vp run generate && rm -rf ./dist && vp exec tsc --project ./tsconfig.build.json",
    "test:consistency": "vp test -- --run tests/lucide-react-consistency.test.ts",
    "test": "vp test",
    "prepublishOnly": "vp run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@pxicons/lucide-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
